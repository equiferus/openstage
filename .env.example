# Fine-grained GitHub token for equiferus/openstage.
# Required permissions: Contents (read/write), Issues (read/write),
# Pull requests (read/write), and Metadata (read).
GITHUB_TOKEN=github_pat_replace_me

# Optional; defaults to equiferus/openstage.
OPENSTAGE_REPO=equiferus/openstage

# Optional; defaults to one hour.
WORKER_INTERVAL_MS=3600000
