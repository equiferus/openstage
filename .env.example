# Fine-grained GitHub token for equiferus/openstage.
# Required permissions: Contents (read), Issues (read/write),
# Pull requests (read/write), and Metadata (read).
GITHUB_TOKEN=github_pat_replace_me

# Optional; defaults to equiferus/openstage.
OPENSTAGE_REPO=equiferus/openstage

# Optional; defaults to 5 minutes.
WORKER_INTERVAL_MS=300000

# Optional. Codex is the default worker engine. Set to true to use OpenCode.
USE_OPENCODE=false

# Optional Codex defaults (equivalent to "luna:low").
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
